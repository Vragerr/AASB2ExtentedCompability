<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="AASBExt_VerticalPortBase" Abstract="True" ParentName="VFEFactory_ConveyorBase">
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
    </statBases>
    <costList>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <modExtensions>
      <li Class="VanillaFurnitureExpandedFactory.ConveyorExtension">
        <ticksPerCell>40</ticksPerCell>
        <itemsPerCell>1</itemsPerCell>
        <maxDistance>8</maxDistance>
      </li>
    </modExtensions>
    <placeWorkers>
      <li>AASB2ExtendedCompatibility.PlaceWorker_VerticalFactoryPort</li>
    </placeWorkers>
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorEntranceUp</defName>
    <label>vertical conveyor input (up)</label>
    <description>An input port for a factory conveyor line. Pair it with a matching port in the same local cell on the adjacent floor. Place the two ports with the same direction label.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorEntrance</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorEntrance/ConveyorUndergroundEntrance</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>true</input>
        <upward>true</upward>
        <legacy>true</legacy>
      </li>
    </comps>
    <designationCategory IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorEntranceDown</defName>
    <label>vertical conveyor input (down)</label>
    <description>An input port for a factory conveyor line. Pair it with a matching port in the same local cell on the adjacent floor. Place the two ports with the same direction label.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorEntrance</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorEntrance/ConveyorUndergroundEntrance</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>true</input>
        <upward>false</upward>
        <legacy>true</legacy>
      </li>
    </comps>
    <designationCategory IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorExitUp</defName>
    <label>vertical conveyor output (up)</label>
    <description>A output port for a factory conveyor line. Pair it with a matching port in the same local cell on the adjacent floor. Place the two ports with the same direction label.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorExit</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorExit/ConveyorUndergroundExit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>false</input>
        <upward>true</upward>
        <legacy>true</legacy>
      </li>
    </comps>
    <designationCategory IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorExitDown</defName>
    <label>vertical conveyor output (down)</label>
    <description>A output port for a factory conveyor line. Pair it with a matching port in the same local cell on the adjacent floor. Place the two ports with the same direction label.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorExit</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorExit/ConveyorUndergroundExit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>false</input>
        <upward>false</upward>
        <legacy>true</legacy>
      </li>
    </comps>
    <designationCategory IsNull="True" />
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorInput</defName>
    <label>vertical conveyor input</label>
    <description>Receives cargo from a Factory line. Select a destination in a continuous shaft from this port.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorEntrance</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorEntrance/ConveyorUndergroundEntrance</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>true</input>
        <section>false</section>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorOutput</defName>
    <label>vertical conveyor output</label>
    <description>Receives cargo from a chosen input and sends it to a horizontal Factory line.</description>
    <thingClass>VanillaFurnitureExpandedFactory.Building_UndergroundConveyorExit</thingClass>
    <graphicData>
      <texPath>Things/Building/UndergroundConveyorExit/ConveyorUndergroundExit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>false</input>
        <section>false</section>
      </li>
    </comps>
  </ThingDef>
  <ThingDef ParentName="AASBExt_VerticalPortBase">
    <defName>AASBExt_VerticalConveyorSection</defName>
    <label>vertical conveyor section</label>
    <description>Continues a conveyor shaft through this floor without unloading cargo.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/ConveyorBelts/Conveyor</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList Inherit="False">
      <Steel>10</Steel>
    </costList>
    <statBases>
      <WorkToBuild>650</WorkToBuild>
    </statBases>
    <rotatable>false</rotatable>
    <comps>
      <li Class="AASB2ExtendedCompatibility.CompProperties_VerticalFactoryPort">
        <input>false</input>
        <section>true</section>
      </li>
    </comps>
  </ThingDef>
</Defs>