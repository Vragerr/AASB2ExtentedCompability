<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="AASB2ExtendedCompatibility.PatchOperationActivePackages">
    <packages>
      <li>astryl.asabovesobelow2</li>
      <li>dubwise.dubsbadhygiene</li>
    </packages>
    <operation Class="PatchOperationConditional">
      <xpath>Defs/ThingDef[defName="sewagePipeStuff" and comps/li[@Class="DubsBadHygiene.CompProperties_Pipe"]/mode="Sewage"]</xpath>
      <match Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="sewagePipeStuff"]/placeWorkers</xpath>
        <match Class="PatchOperationConditional">
          <xpath>Defs/ThingDef[defName="sewagePipeStuff"]/placeWorkers[not(li="AASB2ExtendedCompatibility.PlaceWorker_DbhCarrier")]</xpath>
          <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="sewagePipeStuff"]/placeWorkers</xpath>
            <value>
              <li>AASB2ExtendedCompatibility.PlaceWorker_DbhCarrier</li>
            </value>
          </match>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="sewagePipeStuff"]</xpath>
          <value>
            <placeWorkers>
              <li>AASB2ExtendedCompatibility.PlaceWorker_DbhCarrier</li>
            </placeWorkers>
          </value>
        </nomatch>
      </match>
    </operation>
  </Operation>
</Patch>