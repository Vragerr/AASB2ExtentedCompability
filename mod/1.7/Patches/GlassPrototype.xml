<?xml version='1.0' encoding='utf-8'?>
<Patch>
  <Operation Class="AASB2ExtendedCompatibility.PatchOperationActivePackages">
    <packages>
      <li>astryl.asabovesobelow2</li>
      <li>rebuild.cotr.doorsandcorners</li>
      <li>dubwise.dubsskylights</li>
    </packages>
    <operation Class="PatchOperationConditional">
      <xpath>Defs[TerrainDef[defName="AB_RoofSurface"] and ResearchProjectDef[defName="Smithing"] and DesignationCategoryDef[defName="Floors"] and not(TerrainDef[defName="AASBExt_ExperimentalGlassFloor"]) and ThingDef[defName="RB_Glass"] and RecipeDef[defName="RB_Make_GlassFromChunks"]/products/RB_Glass and ThingDef[defName="SkyLightA"]/costList/RB_Glass]</xpath>
      <match Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
          <TerrainDef>
            <defName>AASBExt_ExperimentalGlassFloor</defName>
            <label>experimental glass roof deck</label>
            <description>A solid roof deck. The optional rendering experiment shows the terrain on the floor immediately below.</description>
            <designationCategory>Floors</designationCategory>
            <texturePath>Terrain/Surfaces/GenericFloorTile</texturePath>
            <color>(0.55, 0.70, 0.76)</color>
            <edgeType>Hard</edgeType>
            <renderPrecedence>240</renderPrecedence>
            <layerable>true</layerable>
            <passability>Standable</passability>
            <pathCost>1</pathCost>
            <fertility>0</fertility>
            <affordances>
              <li>Light</li>
              <li>Medium</li>
              <li>Heavy</li>
            </affordances>
            <statBases>
              <WorkToBuild>1200</WorkToBuild>
            </statBases>
            <costList>
              <Steel>4</Steel>
              <RB_Glass>1</RB_Glass>
            </costList>
            <researchPrerequisites>
              <li>Smithing</li>
            </researchPrerequisites>
            <placeWorkers>
              <li>AASB2ExtendedCompatibility.PlaceWorker_ExperimentalGlassFloor</li>
            </placeWorkers>
          </TerrainDef>
        </value>
      </match>
    </operation>
  </Operation>
